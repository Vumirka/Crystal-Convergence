  m_text: "\u0413\u0440\u0430\u0439\u0442\u0435 \u0440\u0430\u0437\u043E\u043C \u0437
    \u0434\u0440\u0443\u0433\u043E\u043C \u043D\u0430 \u043E\u0434\u043D\u043E\u043C\u0443
    \u043F\u0440\u0438\u0441\u0442\u0440\u043E\u0457! \u041F\u043E \u0447\u0435\u0440\u0437\u0456
    \u0432\u0432\u043E\u0434\u044C\u0442\u0435 \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u0456
    \u043A\u043E\u0434\u0438 \u0442\u0430 \u0437\u043C\u0430\u0433\u0430\u0439\u0442\u0435\u0441\u044F
    \u0443 \u0432\u0433\u0430\u0434\u0443\u0432\u0430\u043D\u043D\u0456 \u0447\u0438\u0441\u0435\u043B.
    \u041D\u0430\u043B\u0430\u0448\u0442\u0443\u0439\u0442\u0435 \u0441\u0432\u043E\u0457
    \u0456\u043C\u0435\u043D\u0430, \u0432\u0438\u0431\u0435\u0440\u0456\u0442\u044C
    \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0438 \u0433\u0440\u0438 \u0442\u0430
    \u043F\u043E\u043A\u0430\u0436\u0456\u0442\u044C, \u0445\u0442\u043E \u043A\u0440\u0430\u0449\u0438\u0439
    \u0443 \u0446\u0456\u0439 \u043B\u043E\u0433\u0456\u0447\u043D\u0456\u0439 \u0431\u0438\u0442\u0432\u0456. "
