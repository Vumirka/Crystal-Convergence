  m_text: "\u0417\u0443\u0441\u0442\u0440\u0456\u0447\u0430\u0439\u0442\u0435 \u0434\u0440\u0443\u0437\u0456\u0432
    \u0430\u0431\u043E \u0456\u043D\u0448\u0438\u0445 \u0433\u0440\u0430\u0432\u0446\u0456\u0432
    \u0443 \u0440\u0435\u0436\u0438\u043C\u0456 \u043E\u043D\u043B\u0430\u0439\u043D.
    \u041F\u0456\u0434\u043A\u043B\u044E\u0447\u0430\u0439\u0442\u0435\u0441\u044F
    \u0434\u043E \u0432\u0436\u0435 \u0430\u043A\u0442\u0438\u0432\u043D\u0438\u0445
    \u0456\u0433\u043E\u0440 \u0430\u0431\u043E \u0441\u0442\u0432\u043E\u0440\u044E\u0439\u0442\u0435
    \u0432\u043B\u0430\u0441\u043D\u0456 \u043A\u0456\u043C\u043D\u0430\u0442\u0438
    \u0434\u043B\u044F \u0437\u043C\u0430\u0433\u0430\u043D\u044C. \u0412\u0432\u0435\u0434\u0456\u0442\u044C
    ID \u043A\u0456\u043C\u043D\u0430\u0442\u0438, \u0449\u043E\u0431 \u043F\u0440\u0438\u0454\u0434\u043D\u0430\u0442\u0438\u0441\u044F
    \u0434\u043E \u043F\u0430\u0440\u0442\u0456\u0457 \u0437 \u0434\u0440\u0443\u0433\u043E\u043C,
    \u0430\u0431\u043E \u043D\u0430\u043B\u0430\u0448\u0442\u0443\u0439\u0442\u0435
    \u0441\u0432\u043E\u0454 \u0456\u043C'\u044F \u0434\u043B\u044F \u0433\u0440\u0438. "
  m_isRightToLeft: 0
