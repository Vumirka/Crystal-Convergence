      m_Calls: []
  m_text: "\u041F\u043E\u0440\u0438\u043D\u044C\u0442\u0435 \u0443 \u0441\u0432\u0456\u0442
    \u0433\u0440\u0438 \u0442\u0430 \u0442\u0440\u0435\u043D\u0443\u0439\u0442\u0435
    \u0441\u0432\u043E\u0457 \u043D\u0430\u0432\u0438\u0447\u043A\u0438 \u0443 \u0440\u0435\u0436\u0438\u043C\u0456
    \u0437 \u0431\u043E\u0442\u043E\u043C. \u0412\u0456\u0434\u0433\u0430\u0434\u0443\u0439\u0442\u0435
    \u0447\u0438\u0441\u043B\u0430, \u0443\u0434\u043E\u0441\u043A\u043E\u043D\u0430\u043B\u044E\u0439\u0442\u0435
    \u0441\u0432\u043E\u044E \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u044E
    \u0442\u0430 \u043F\u0456\u0434\u043A\u043E\u0440\u044E\u0439\u0442\u0435 \u043B\u043E\u0433\u0456\u0447\u043D\u0456
    \u0432\u0438\u043A\u043B\u0438\u043A\u0438 \u0431\u0435\u0437 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0433\u043E
    \u0442\u0438\u0441\u043A\u0443 \u0437 \u0431\u043E\u043A\u0443 \u0456\u043D\u0448\u0438\u0445
    \u0433\u0440\u0430\u0432\u0446\u0456\u0432."
